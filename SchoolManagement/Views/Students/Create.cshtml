@model StudentEntity

<form asp-controller="Students" asp-action="CreateStudent" method="post" class="container p-4 border">
    <br />
    <div class="container p-4 border p-3">
        <h1 class="text-primary">New Students</h1>
        <hr />
        <div class="row">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="col-2">
                <label asp-for="Name" class="control-lable pt-2" style="font-size:14px;"></label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-2">
                <label asp-for="Age" class="control-lable pt-2" style="font-size:14px;"></label>
            </div>
            <div class="col-10 pb-3">
                <input type="number" asp-for="Age" class="form-control" />
                <span asp-validation-for="Age" class="text-danger"></span>
            </div>
            <div class="col-2">
                <label asp-for="Standard" class="control-lable pt-2" style="font-size:14px;"></label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="Standard" class="form-control" />
                <span asp-validation-for="Standard" class="text-danger"></span>
            </div>
            <div class="col-2">
                <label asp-for="EmailAddress" class="control-lable pt-2" style="font-size:14px;"></label>
            </div>
            <div class="col-10 pb-3">
                <input type="email" asp-for="EmailAddress" class="form-control" />
                <span asp-validation-for="EmailAddress" class="text-danger"></span>
            </div>
            <br />
            <div class="col-5 offset-2">
                <a asp-action="Index" asp-controller="Students" class="btn btn-primary form-control" > Back To List</a>
            </div>
            <div class="col-5">
                <input type="submit" value="Submit" class="btn btn-success form-control">
            </div>
        </div>
    </div>
</form>
<br />

@section Scripts {
    <partial name="_ValidationScriptsPartial.cshtml" />
}